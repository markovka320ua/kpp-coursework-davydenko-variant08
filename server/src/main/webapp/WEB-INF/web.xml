<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Water Quality Server</display-name>

  <servlet>
    <servlet-name>PingServlet</servlet-name>
    <servlet-class>ua.nupp.kpp.server.web.PingServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PingServlet</servlet-name>
    <url-pattern>/api/ping</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PointServlet</servlet-name>
    <servlet-class>ua.nupp.kpp.server.web.PointServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PointServlet</servlet-name>
    <url-pattern>/api/points</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SampleServlet</servlet-name>
    <servlet-class>ua.nupp.kpp.server.web.SampleServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SampleServlet</servlet-name>
    <url-pattern>/api/samples</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>MeasurementServlet</servlet-name>
    <servlet-class>ua.nupp.kpp.server.web.MeasurementServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>MeasurementServlet</servlet-name>
    <url-pattern>/api/measurements</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>InspectionServlet</servlet-name>
    <servlet-class>ua.nupp.kpp.server.web.InspectionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>InspectionServlet</servlet-name>
    <url-pattern>/api/inspections</url-pattern>
  </servlet-mapping>

</web-app>
